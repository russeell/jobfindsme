{
  "name": "@jobfindsme/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "build:python-runtime": "PYINSTALLER_CONFIG_DIR=/private/tmp/jobfindsme-pyinstaller ../../.venv/bin/python -m PyInstaller --clean --noconfirm --distpath runtime/python --workpath ../../build/jobfindsme-api ../../scripts/jobfindsme_api.spec",
    "dev": "vite",
    "start": "electron .",
    "pack:mac:dir": "npm run build && node scripts/package-macos.mjs",
    "audit:mac:dir": "node scripts/audit-macos-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsc -p tsconfig.electron.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
