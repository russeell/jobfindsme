{
  "name": "@jobfindsme/desktop",
  "private": true,
  "version": "0.15.4",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "npm run typecheck && vite build && npm run clean:electron && tsc -p tsconfig.electron.json && node scripts/build-provenance.mjs --record",
    "build:python-runtime": "PYINSTALLER_CONFIG_DIR=/private/tmp/jobfindsme-pyinstaller ../../.venv/bin/python ../../scripts/freeze_desktop_api.py",
    "dev": "vite",
    "start": "electron .",
    "pack:mac:dir": "npm run build && node scripts/package-macos.mjs",
    "audit:mac:dir": "node scripts/audit-macos-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsc -p tsconfig.electron.json && node --test tests/*.test.mjs",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron', {recursive:true, force:true})\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.27",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2"
  }
}
